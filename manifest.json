{
  "manifest_version": 3,
  "name": "AI ELIT Solver",
  "version": "1.5.5",
  "description": "AI answers for ELIT tests: picks the right options or just shows them. Stealth mode, any OpenRouter model, cost tracking.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "https://mix.sumdu.edu.ua/*",
    "https://cabinet.sumdu.edu.ua/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mix.sumdu.edu.ua/*",
        "https://cabinet.sumdu.edu.ua/*"
      ],
      "js": [
        "models.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI ELIT Solver"
  }
}
