{
  "manifest_version": 3,
  "name": "AI ELIT Solver",
  "version": "1.4.4",
  "description": "Automatically answers quiz questions using AI",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "https://mix.sumdu.edu.ua/*",
    "https://cabinet.sumdu.edu.ua/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mix.sumdu.edu.ua/*",
        "https://cabinet.sumdu.edu.ua/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
        "16":"icons/icon16.png",
        "32":"icons/icon32.png",
        "48":"icons/icon48.png",
        "128":"icons/icon128.png"
    },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI ELIT Solver"
  }
}